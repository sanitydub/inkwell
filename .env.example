# Where the SQLite database lives (created if missing).
DATA_DIR=./data

# Set to "false" to stop new sign-ups. The very first account can always be created.
ALLOW_REGISTRATION=true

# Production only (adapter-node): the public URL people use to reach the app.
# ORIGIN=https://notes.example.com
# Largest request body accepted, e.g. for very long notes.
# BODY_SIZE_LIMIT=10M

# Largest image or file one attachment may be. Default 10M.
# MAX_ATTACHMENT_SIZE=10M
