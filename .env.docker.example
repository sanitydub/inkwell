# Copy to .env (next to docker-compose.yml) and adjust. Docker Compose reads it automatically.

# Port on this machine. Change it if 3000 is already in use.
INKWELL_PORT=3000

# The exact address people use to reach Inkwell, including the port.
# Examples: http://192.168.1.20:3000, http://myserver:3000, https://notes.example.com
INKWELL_ORIGIN=http://localhost:3000

# "false" stops new sign-ups. The first account is always allowed, and admins can add people.
ALLOW_REGISTRATION=true

# Behind a reverse proxy, uncomment so each visitor gets their own sign-in limit.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
